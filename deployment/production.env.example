# Modelo somente. Copie para /srv/mindos/config/production.env (chmod 600).
# Nunca copie o .env de desenvolvimento para produção.
APP_ORIGIN=https://clinica.example.com
VITE_APP_ID=SUBSTITUA_APLICATIVO_MANUS
OWNER_OPEN_ID=SUBSTITUA_IDENTIDADE_MANUS_DO_RESPONSAVEL
OAUTH_SERVER_URL=https://auth.example.com
VITE_OAUTH_PORTAL_URL=https://login.example.com
PUBLIC_TENANT_SLUG=SUBSTITUA_CLINICA
JWT_SECRET=SUBSTITUA_SEGREDO_INDEPENDENTE
CLINICAL_INTEGRITY_SECRET=SUBSTITUA_SEGREDO_INDEPENDENTE
DOCUMENT_ENCRYPTION_SECRET=SUBSTITUA_SEGREDO_INDEPENDENTE
RECOVERY_RECEIPT_PUBLIC_KEY=SUBSTITUA_CHAVE_PUBLICA_ED25519_BASE64
PROD_DB_PASSWORD=SUBSTITUA_BASE64URL_32_A_128_CARACTERES
PROD_MIGRATION_PASSWORD=SUBSTITUA_OUTRA_SENHA_FORTE
PROD_DB_ROOT_PASSWORD=SUBSTITUA_OUTRA_SENHA_FORTE
# Senha codificada para URL; mesmo usuário/senha do MySQL acima.
PROD_DATABASE_URL=mysql://mindos:SUBSTITUA_SENHA_CODIFICADA@mysql:3306/mindos
PROD_MIGRATION_DATABASE_URL=mysql://mindos_migrator:SUBSTITUA_SENHA_CODIFICADA@mysql:3306/mindos
MINDOS_DATA_ROOT=/srv/mindos/private
PROD_DB_VOLUME=mindos-production-mysql
PROD_DB_PORT=3308
PROD_APP_PORT=3000
MINDOS_IMAGE=mindos:stage8-review
MINDOS_DOCKER_SUBNET=172.30.77.0/24
MINDOS_DOCKER_GATEWAY=172.30.77.1
TRUST_PROXY_CIDRS=172.30.77.1/32
