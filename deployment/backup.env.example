# Somente no host operacional, fora do contêiner do app. Arquivo real: chmod 600.
APP_ENV=production
BACKUP_DATABASE_URL=mysql://mindos_migrator:SUBSTITUA_SENHA_CODIFICADA@127.0.0.1:3308/mindos
BACKUP_SOURCE_CONTAINER=SUBSTITUA_CONTAINER_MYSQL
BACKUP_APP_CONTAINER=SUBSTITUA_CONTAINER_APP_PARADO
PRIVATE_DOCUMENT_ROOT=/srv/mindos/private/documents
BACKUP_ROOT=/srv/mindos/backups
BACKUP_ENCRYPTION_KEY=SUBSTITUA_32_BYTES_BASE64
CLINICAL_INTEGRITY_SECRET=SUBSTITUA_SEGREDO_EXISTENTE
DOCUMENT_ENCRYPTION_SECRET=SUBSTITUA_SEGREDO_EXISTENTE
