# Desenvolvimento local. Copie para .env e gere senhas próprias.
NODE_ENV=development
APP_ENV=local
HOST=127.0.0.1
SESSION_TTL_HOURS=8
PORT=3000
DATABASE_URL=mysql://mindos:SUBSTITUA_A_SENHA@127.0.0.1:3307/mindos_dev
DEV_DB_PASSWORD=SUBSTITUA_A_SENHA
DEV_DB_ROOT_PASSWORD=SUBSTITUA_A_SENHA_ROOT
DEV_DB_VOLUME=mindos-development_mysql_data
JWT_SECRET=SUBSTITUA_POR_UMA_CHAVE_ALEATORIA_DE_PELO_MENOS_32_CARACTERES

# Login atual: OAuth Manus. Não existe login local por senha nesta etapa.
VITE_APP_ID=
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=
PUBLIC_TENANT_SLUG=mindos-psychology

# Integrações opcionais. Nunca coloque segredos em variáveis VITE_.
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Diagnóstico de navegador desativado; pode capturar conteúdo sensível.
ENABLE_MANUS_DEBUG=false

# Exige banco local chamado mindos_dev ou mindos_test. Não funciona em produção.
ALLOW_DEMO_SEED=false

# Prontuário e documentos privados: gere segredos independentes e preserve-os com o backup.
CLINICAL_INTEGRITY_SECRET=
DOCUMENT_ENCRYPTION_SECRET=
# Fora de client/ e dist/public; volume privado persistente na implantação.
PRIVATE_DOCUMENT_ROOT=.mindos-private/documents

# Backup local criptografado: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Guarde esta chave separada do arquivo de backup; não a reutilize.
BACKUP_ENCRYPTION_KEY=
# Somente a chave pública vai para o app em produção. Gere no host operacional:
# node scripts/recovery-public-key.mjs
RECOVERY_RECEIPT_PUBLIC_KEY=
BACKUP_ROOT=.mindos-private/backups
BACKUP_SOURCE_CONTAINER=mindos-development-mysql-1
# Em produção, exige o nome do contêiner da aplicação já parado.
BACKUP_APP_CONTAINER=
